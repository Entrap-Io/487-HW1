<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upload_title"
            android:textColor="@color/dressCode"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textAlignment="center"
            android:paddingVertical="@dimen/spacing_m" />

        <!-- Image preview / tap zone -->
        <FrameLayout
            android:id="@+id/imagePickerZone"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@color/surface_variant"
            android:layout_marginBottom="@dimen/spacing_m">

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/uploadPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_hint"
                    android:textColor="@color/dressCodeCaption"
                    android:textSize="@dimen/text_body"
                    android:textAlignment="center"
                    android:paddingTop="@dimen/spacing_s" />

            </LinearLayout>
        </FrameLayout>

        <!-- Camera / Gallery buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_m">

            <Button
                android:id="@+id/cameraBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Camera"
                android:layout_marginEnd="@dimen/spacing_s"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/on_surface" />

            <Button
                android:id="@+id/galleryBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Gallery"
                android:layout_marginStart="@dimen/spacing_s"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/on_surface" />

        </LinearLayout>

        <!-- Rating SeekBar -->
        <TextView
            android:id="@+id/ratingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rating: 5 / 10"
            android:textColor="@color/rating_color"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:paddingBottom="@dimen/spacing_s" />

        <SeekBar
            android:id="@+id/ratingSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4"
            android:progressTint="@color/rating_color"
            android:thumbTint="@color/rating_color"
            android:layout_marginBottom="@dimen/spacing_l" />

        <!-- Category stats returned from Wardrobe -->
        <TextView
            android:id="@+id/categoryStatsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dressCodeCaption"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Browse closet button (triggers startActivityForResult) -->
        <Button
            android:id="@+id/browseClosetBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Browse Closet for Reference"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Add to closet -->
        <Button
            android:id="@+id/addToClosetBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/analyze_btn"
            android:backgroundTint="@color/dressCode"
            android:textColor="@color/white"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Progress indicator -->
        <LinearLayout
            android:id="@+id/uploadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_m">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/spacing_s" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing with Gemini AI…"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
