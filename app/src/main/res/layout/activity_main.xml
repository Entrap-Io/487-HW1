<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="@dimen/spacing_m">

    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

    <!-- Blinking title -->
    <TextView
        android:id="@+id/dressCode"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_layout_height"
        android:paddingVertical="@dimen/title_vertical_padding"
        android:text="@string/dressCode"
        android:textAlignment="center"
        android:textColor="@color/dressCode"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dressCodeCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/caption_vertical_padding"
        android:text="@string/dressCodeCaption"
        android:textAlignment="center"
        android:textColor="@color/dressCodeCaption"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

    <!-- Outfit of the day card -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Outfit"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold"
        android:paddingBottom="@dimen/spacing_s" />

    <androidx.cardview.widget.CardView
        android:id="@+id/outfitCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <TextView
                android:id="@+id/outfitName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_outfit_yet"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body"
                android:textAlignment="center"
                android:minHeight="60dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/outfitReasoning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dressCodeCaption"
                android:textSize="12sp"
                android:paddingTop="@dimen/spacing_s"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_l" />

    <!-- Navigation spinner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Navigate to"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_body"
        android:paddingBottom="@dimen/spacing_s" />

    <Spinner
        android:id="@+id/mainMenu"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface_variant"
        android:popupBackground="@color/surface_variant" />

    <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_m" />

    <Button
        android:id="@+id/selBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/selBtn"
        android:backgroundTint="@color/dressCode"
        android:textColor="@color/white" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom outfit items preview -->
    <TextView
        android:id="@+id/outfitItemsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dressCodeCaption"
        android:textSize="12sp"
        android:paddingBottom="@dimen/spacing_s"
        android:visibility="gone" />

</LinearLayout>
